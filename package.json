{
    "name": "react-tailwindcss-datepicker",
    "version": "1.6.6",
    "description": "A modern React Datepicker using Tailwind CSS 3",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "author": "onesine",
    "license": "MIT",
    "scripts": {
        "watch": "rollup -c -w",
        "clean": "rm -rf dist",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "pret": "prettier -c .",
        "pret:fix": "prettier --ignore-path .gitignore --config ./.prettierrc --write './**/*.{js,jsx,ts,tsx,css,md,json}'",
        "code-style": "npm run pret && npm run lint",
        "code-style:fix": "npm run pret:fix && npm run pret:fix",
        "build": "npm run code-style && npm run clean && rollup -c",
        "pub": "npm run build && npm publish",
        "dev": "next dev -p 8888",
        "prepare": "husky install"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/onesine/react-tailwindcss-datepicker"
    },
    "keywords": [
        "react-tailwindcss-datepicker",
        "react-datepicker",
        "tailwind-datepicker",
        "datepicker",
        "date-picker",
        "daterangepicker",
        "react-daterangepicker",
        "date-range",
        "date-range-picker",
        "tailwind-daterange-picker"
    ],
    "peerDependencies": {
        "dayjs": "^1.11.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "catalog:",
        "@rollup/plugin-commonjs": "^24.1.0",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/plugin-typescript": "^11.1.6",
        "@tailwindcss/forms": "^0.5.11",
        "@types/node": "18.14.5",
        "@types/react": "^19.2.14",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "autoprefixer": "^10.5.0",
        "dayjs": "^1.11.20",
        "eslint": "catalog:",
        "eslint-config-next": "^16.2.6",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "husky": "^8.0.3",
        "lint-staged": "^13.3.0",
        "next": "16.2.11",
        "postcss": "^8.5.14",
        "prettier": "^2.8.8",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "rollup": "^2.80.0",
        "tailwindcss": "^3.4.19",
        "tslib": "^2.8.1",
        "typescript": "^4.9.5"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "npm run lint"
        ],
        "*.{ts,tsx,css,scss,md}": [
            "npm run pret:fix"
        ]
    }
}
